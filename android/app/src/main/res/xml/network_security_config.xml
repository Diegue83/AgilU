<?xml version="1.0" encoding="utf-8"?>
<!--
  Seguridad de transporte de ÁgilU.
  - Sin tráfico HTTP en claro: todo sale por TLS (los servidores de Firebase
    negocian TLS 1.3 con Android 10 o superior).
  - Solo se confía en las CA del sistema, no en certificados instalados por el usuario.
  - Pinning a las llaves raíz de Google Trust Services para los dominios de Firebase.
    La expiración evita que la app quede sin conexión si Google cambia de raíz;
    antes de esa fecha hay que revisar los pines y renovarla.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">firebaseio.com</domain>
        <pin-set expiration="2027-11-01">
            <!-- GTS Root R1 -->
            <pin digest="SHA-256">hxqRlPTu1bMS/0DITB1SSu0vd4u/8l8TjPgfaAp63Gc=</pin>
            <!-- GTS Root R4 -->
            <pin digest="SHA-256">mEflZT5enoR1FuXLgYYGqnVEoZvmf9c2bVBpiOjYQ0c=</pin>
            <!-- GlobalSign Root CA (firma cruzada de GTS Root R1/R4) -->
            <pin digest="SHA-256">K87oWBWM9UZfyddvDfoxL+8lpNyoUB2ptGtn0fv6G2Q=</pin>
        </pin-set>
    </domain-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
