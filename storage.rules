rules_version = '2';

// Las fotos de productos se suben solo con la función subirFotoProducto, que
// valida al encargado. Los clientes las leen con la URL de descarga que guarda
// la función; nadie puede escribir ni listar el bucket directamente.
service firebase.storage {
  match /b/{bucket}/o {
    match /{todo=**} {
      allow read, write: if false;
    }
  }
}
