rules_version = '2';

// La app ya no usa Firestore: los datos viven en SQL Connect (dataconnect/).
// Se cierra todo el acceso para que nadie pueda escribir en la base vieja.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
